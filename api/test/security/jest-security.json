{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../..",
  "testRegex": "test/security/.*\\.spec\\.ts$",
  "extensionsToTreatAsEsm": [".ts"],
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "useESM": true }]
  },
  "moduleNameMapper": {
    "^@common/(.*)\\.js$": "<rootDir>/src/common/$1",
    "^@core/(.*)\\.js$": "<rootDir>/src/core/$1",
    "^@feature/(.*)\\.js$": "<rootDir>/src/feature/$1",
    "^@root/(.*)\\.js$": "<rootDir>/src/root/$1",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "testEnvironment": "node"
}
